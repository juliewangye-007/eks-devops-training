</> groovy

pipeline {
    agent any

    stages {

        stage('Hello') {
            steps {
                echo 'Starting EKS DevOps Pipeline'
            }
        }

        stage('Build') {
            steps {
                echo 'Building application'
            }
        }

        stage('Test') {
            steps {
                echo 'Testing application'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application'
            }
        }
    }
}
